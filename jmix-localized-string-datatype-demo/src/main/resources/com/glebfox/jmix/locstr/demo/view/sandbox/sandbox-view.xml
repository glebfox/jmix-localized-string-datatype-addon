<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://sandboxView.title">
    <data>
        <collection id="productsDc" class="com.glebfox.jmix.locstr.demo.entity.Product">
            <loader id="productsDl" readOnly="true">
                <query>
                    <![CDATA[select e from locstr_Product e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <entityComboBox metaClass="locstr_Product"
                        itemsContainer="productsDc"/>
    </layout>
</view>